# Copy to /etc/smartreviewlabs/deploy.env on the server (chmod 600).
SITE_NAME=smartreviewlabs
APP_DIR=/var/www/smartreviewlabs
GIT_REPO=https://github.com/tranthanhtuan269/hako.git
GIT_BRANCH=ontopcoupon
LOG_FILE=/var/log/smartreviewlabs-auto-update.log
LOCK_FILE=/var/run/smartreviewlabs-auto-update.lock
GIT_CREDENTIALS_FILE=/etc/smartreviewlabs/git-credentials
