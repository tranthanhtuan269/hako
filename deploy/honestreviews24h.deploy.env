# Copy to /etc/honestreviews24h/deploy.env on the server (chmod 600).
SITE_NAME=honestreviews24h
APP_DIR=/var/www/honestreviews24h
GIT_REPO=https://github.com/tranthanhtuan269/hako.git
GIT_BRANCH=coupontracer
LOG_FILE=/var/log/honestreviews24h-auto-update.log
LOCK_FILE=/var/run/honestreviews24h-auto-update.lock
GIT_CREDENTIALS_FILE=/etc/honestreviews24h/git-credentials
